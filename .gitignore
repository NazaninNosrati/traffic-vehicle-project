# Data — never commit the dataset itself
data/raw/**
data/processed/**
!data/raw/
!data/raw/.gitkeep
!data/processed/
!data/processed/.gitkeep
!data/processed/imbalanced_train_indices.csv
!data/processed/neysan_val_files.csv
# Model checkpoints (large binary files)
checkpoints/*.pt
checkpoints/*.pth
!checkpoints/.gitkeep

# Logs (regenerated on every run)
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
.vscode/

# Personal notes — remove this line if you decide to push NOTES.md
NOTES.md
